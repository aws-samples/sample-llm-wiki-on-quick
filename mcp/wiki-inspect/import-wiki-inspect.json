{
  "mcpServers": {
    "wiki-inspect": {
      "description": "Quick 上 LLM Wiki 的只读校验层：lint / edges / index_status / hubs",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "fastmcp",
        "python",
        "-c",
        "import os,runpy; runpy.run_path(os.path.expanduser(\"~/.quickwork/mcp-servers/wiki-inspect/server.py\"), run_name=\"__main__\")"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "120"
      }
    }
  }
}
